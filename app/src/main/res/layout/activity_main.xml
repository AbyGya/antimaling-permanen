<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AntiMaling Permanen"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Panel pemilik — aktifkan 1x, proteksi selamanya."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/card"
            android:padding="12dp"
            android:text="Status: -"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="1. PIN &amp; Nomor Kepercayaan"
            android:textColor="@color/text"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="PIN pemilik (mis. 1234)"
            android:inputType="numberPassword"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <EditText
            android:id="@+id/etTrusted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="No HP trusted (mis. +62812...)"
            android:inputType="phone"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <EditText
            android:id="@+id/etCustomText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Teks overlay custom"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Simpan PIN &amp; Teks" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="2. Aktifkan Proteksi (wajib 1x)"
            android:textColor="@color/text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Aktifkan Device Admin" />

        <Button
            android:id="@+id/btnOverlayPerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Izinkan Overlay" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Minta Bebas Battery Optimization" />

        <Button
            android:id="@+id/btnPerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Minta Izin SMS / Lokasi / Kamera" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="3. Tes Fitur"
            android:textColor="@color/text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTestLock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tes Kunci + Overlay" />

        <Button
            android:id="@+id/btnTestRing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tes Dering Max Volume" />

        <Button
            android:id="@+id/btnTestFlash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tes Senter Kedip + Dering" />

        <Button
            android:id="@+id/btnLocate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tes Lacak Lokasi" />

        <Button
            android:id="@+id/btnOverlayOn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Overlay ON (Home/Lock)" />

        <Button
            android:id="@+id/btnOverlayOff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Overlay OFF" />

        <Button
            android:id="@+id/btnStopAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STOP Semua Alarm" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="4. Mode Siluman"
            android:textColor="@color/text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnHideIcon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sembunyikan Ikon" />

        <Button
            android:id="@+id/btnShowIcon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tampilkan Ikon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="5. Kontrol Laptop (Cloud)"
            android:textColor="@color/text"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Buat project di console.firebase.google.com → aktifkan Firestore + Authentication Anonymous. Tempel Web API Key + Project ID, lalu Generate kode pairing. Kode yang sama dimasukkan di panel laptop."
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etFbKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Firebase Web API Key"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <EditText
            android:id="@+id/etFbProject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Firebase Project ID"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <Button
            android:id="@+id/btnCloudSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Simpan &amp; Generate Kode Pairing" />

        <TextView
            android:id="@+id/tvPair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/card"
            android:padding="12dp"
            android:text="Kode pairing: -"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnShotConsent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Aktifkan Sadap Layar" />

        <Button
            android:id="@+id/btnCloudTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tes Koneksi Cloud" />

        <Button
            android:id="@+id/btnPairNew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate Ulang Kode Pairing" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:layout_marginTop="16dp"
            android:text="Remote via SMS dari No trusted:\n#LOCK#pin #UNLOCK#pin #RING #STOP #LOCATE #FLASH#durasi-detik #TEXT#isi pesan #OVERLAY#ON/OFF"
            android:textColor="@color/muted"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>

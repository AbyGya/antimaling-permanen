<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠ PERANGKAT TERKUNCI ⚠"
            android:textColor="#FF3B30"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLockText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="HP HILANG! Hubungi pemilik."
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <!--
          Foto pencuri + jejak lokasi. Sengaja DI ATAS tombol PIN supaya
          Whoever yang memegang HP langsung melihatnya sebelum sempat
          mencoba membuka kunci.
        -->
        <LinearLayout
            android:id="@+id/llEvidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#B3000000"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgMaling"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:adjustViewBounds="true"
                android:background="#111"
                android:contentDescription="Foto pencuri"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tvWarn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="HP ini sedang dilacak. Foto dan lokasi dikirim ke pemilik."
                android:textColor="#FF5252"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="Mencari lokasi…"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Perangkat terlacak. Masukkan PIN pemilik untuk buka."
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <!--
          Listener keypad dipasang lewat android:onClick, bukan findViewById.
          Alasannya: kalau findViewById gagal / lempar exception, listener-nya
          hilang tanpa jejak dan keypad jadi mati total (bug "gabisa dipencet").
          Dengan onClick, Android sendiri yang mengaitkannya saat inflate.
        -->

        <!-- Display PIN (keyboard sistem sengaja dimatikan — pakai keypad bawah) -->
        <EditText
            android:id="@+id/etUnlockPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:cursorVisible="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:gravity="center"
            android:hint="• • • •"
            android:importantForAccessibility="no"
            android:inputType="numberPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#94A3B8"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnN1"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:onClick="onKeypadClick"
                android:tag="1"
                android:text="1"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnN2"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:onClick="onKeypadClick"
                android:tag="2"
                android:text="2"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnN3"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:onClick="onKeypadClick"
                android:tag="3"
                android:text="3"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnN4"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:onClick="onKeypadClick"
                android:tag="4"
                android:text="4"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnN5"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:onClick="onKeypadClick"
                android:tag="5"
                android:text="5"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnN6"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:onClick="onKeypadClick"
                android:tag="6"
                android:text="6"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnN7"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:onClick="onKeypadClick"
                android:tag="7"
                android:text="7"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnN8"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:onClick="onKeypadClick"
                android:tag="8"
                android:text="8"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnN9"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:onClick="onKeypadClick"
                android:tag="9"
                android:text="9"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:onClick="onKeypadClick"
                android:tag="clear"
                android:text="C"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnN0"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:onClick="onKeypadClick"
                android:tag="0"
                android:text="0"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnDel"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:onClick="onKeypadClick"
                android:tag="del"
                android:text="⌫"
                android:textSize="18sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnUnlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="8dp"
            android:onClick="onUnlockClick"
            android:text="BUKA KUNCI" />

    </LinearLayout>
</ScrollView>
